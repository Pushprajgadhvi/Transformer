   "source": [
    "from nltk.translate.bleu_score import sentence_bleu\n",
    "\n",
    "reference = [[\"the\", \"cat\", \"is\", \"on\", \"the\", \"mat\"]]\n",
    "candidate = [\"the\", \"cat\", \"is\", \"on\", \"mat\"]\n",
    "\n",
    "score = sentence_bleu(reference, candidate)\n",
    "\n",
    "print(\"BLEU score:\", score)"
   ]
